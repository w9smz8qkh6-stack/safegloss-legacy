# Copy this file to config/dev.env for local development.
# Never commit real credentials.

DEBUG=True
SECRET_KEY=replace-with-a-local-development-key
DATABASE_URL=postgres://rgx_user:rgx_password@localhost:5432/rgx_db
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Optional integrations
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POSTHOG_API_KEY=
POSTHOG_HOST=

# Production security. Enable HSTS only after HTTPS is working everywhere.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
