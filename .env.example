APP_ENV=development
APP_KEY=replace-with-a-random-secret-before-sharing
APP_URL=http://localhost:8088
WEB_PORT=8088

DB_NAME=safegloss_legacy
DB_USER=safegloss
DB_PASSWORD=replace-with-a-local-database-password
DB_ROOT_PASSWORD=replace-with-a-local-root-password

# Database capture is intentionally non-delivering and is the safe default.
MAIL_TRANSPORT=database
MAIL_FROM=webmaster@safegloss.invalid
RESEARCH_REPORT_TO=researcher@safegloss.invalid

# Required only when MAIL_TRANSPORT=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
