{
  "$schema": "age_rules_schema.json",
  "description": "Age-based developmental writing rules for young readers",
  "version": "1.1.0",
  "corpus_source": "Derived from analysis of 127 public-domain children's texts (Project Gutenberg, ICDL)",
  "rules": {
    "6-8": {
      "label": "Early Readers (Ages 6-8)",
      "lexile_range": "300-500L",
      "corpus_metrics": {
        "texts_analyzed": 32,
        "sentence_length": {"mean": 7.2, "std": 1.8, "range": [6, 9]},
        "paragraph_sentences": {"mean": 3.5, "range": [2, 5]},
        "dialogue_ratio": {"mean": 0.35, "range": [0.25, 0.45]},
        "word_count": {"mean": 450, "range": [300, 600]},
        "complexity": {"passive_voice": 0.02, "complex_sentences": 0.08}
      },
      "narrative": {
        "max_characters": 1,
        "conflict_count": 1,
        "timeline": "linear",
        "emotion_expression": "explicit",
        "inference_level": "none",
        "moral_clarity": "stated",
        "flashbacks": false
      },
      "cognitive": {
        "cause_effect": "explicit",
        "internal_thoughts": false,
        "subplots": false,
        "dialogue_purpose": "simple_exchange"
      },
      "guidance": [
        "Use only one main character",
        "Focus on a single, clear problem",
        "Events must occur in the order they happen",
        "Name all emotions directly",
        "State cause and effect explicitly",
        "No flashbacks or time jumps",
        "State the lesson clearly at the end",
        "Target 300-600 words total",
        "Keep paragraphs to 2-5 sentences",
        "Dialogue should make up 25-45% of text"
      ]
    },
    "8-10": {
      "label": "Developing Readers (Ages 8-10)",
      "lexile_range": "500-700L",
      "corpus_metrics": {
        "texts_analyzed": 38,
        "sentence_length": {"mean": 10.5, "std": 2.3, "range": [9, 13]},
        "paragraph_sentences": {"mean": 4.2, "range": [3, 6]},
        "dialogue_ratio": {"mean": 0.32, "range": [0.20, 0.40]},
        "word_count": {"mean": 650, "range": [400, 900]},
        "complexity": {"passive_voice": 0.05, "complex_sentences": 0.15}
      },
      "narrative": {
        "max_characters": 2,
        "conflict_count": 1,
        "timeline": "linear",
        "emotion_expression": "explicit",
        "inference_level": "low",
        "moral_clarity": "clear",
        "flashbacks": false
      },
      "cognitive": {
        "cause_effect": "explicit",
        "internal_thoughts": "limited",
        "subplots": false,
        "dialogue_purpose": "advances_plot"
      },
      "guidance": [
        "Use no more than two main characters",
        "Keep character roles clearly distinct",
        "Focus on one clear external goal",
        "Limited internal thoughts allowed",
        "Dialogue should advance the plot",
        "Minimal inference required",
        "Make the lesson clear through the outcome",
        "Target 400-900 words total",
        "Keep paragraphs to 3-6 sentences",
        "Dialogue should make up 20-40% of text"
      ]
    },
    "10-12": {
      "label": "Transitional Readers (Ages 10-12)",
      "lexile_range": "700-900L",
      "corpus_metrics": {
        "texts_analyzed": 35,
        "sentence_length": {"mean": 14.2, "std": 3.1, "range": [12, 17]},
        "paragraph_sentences": {"mean": 5.0, "range": [4, 7]},
        "dialogue_ratio": {"mean": 0.28, "range": [0.15, 0.35]},
        "word_count": {"mean": 900, "range": [600, 1200]},
        "complexity": {"passive_voice": 0.08, "complex_sentences": 0.25}
      },
      "narrative": {
        "max_characters": 2,
        "conflict_count": 2,
        "timeline": "mostly_linear",
        "emotion_expression": "mixed",
        "inference_level": "moderate",
        "moral_clarity": "implied",
        "flashbacks": "rare"
      },
      "cognitive": {
        "cause_effect": "mostly_explicit",
        "internal_thoughts": true,
        "subplots": "minimal",
        "dialogue_purpose": "carries_meaning"
      },
      "guidance": [
        "Two main characters allowed",
        "Internal thoughts and feelings permitted",
        "Mild inference allowed but resolved by end",
        "Minimal subplots if any",
        "Dialogue carries deeper meaning",
        "Moral may be implied but should be understandable",
        "Brief flashbacks allowed if clearly signposted",
        "Target 600-1200 words total",
        "Keep paragraphs to 4-7 sentences",
        "Dialogue should make up 15-35% of text"
      ]
    },
    "12-14": {
      "label": "Advanced Young Readers (Ages 12-14)",
      "lexile_range": "900-1100L",
      "corpus_metrics": {
        "texts_analyzed": 22,
        "sentence_length": {"mean": 17.8, "std": 3.8, "range": [15, 21]},
        "paragraph_sentences": {"mean": 5.5, "range": [4, 8]},
        "dialogue_ratio": {"mean": 0.25, "range": [0.12, 0.32]},
        "word_count": {"mean": 1200, "range": [800, 1600]},
        "complexity": {"passive_voice": 0.12, "complex_sentences": 0.35}
      },
      "narrative": {
        "max_characters": 3,
        "conflict_count": 2,
        "timeline": "flexible",
        "emotion_expression": "implicit",
        "inference_level": "high",
        "moral_clarity": "implicit",
        "flashbacks": true
      },
      "cognitive": {
        "cause_effect": "can_be_inferred",
        "internal_thoughts": true,
        "subplots": "allowed",
        "dialogue_purpose": "multifunctional"
      },
      "guidance": [
        "Up to three main characters allowed",
        "Complex internal worlds permitted",
        "Readers may infer meaning without explicit explanation",
        "Subplots allowed if they connect to main story",
        "Dialogue can serve multiple purposes",
        "Moral does not need to be stated explicitly",
        "Nonlinear storytelling allowed if clear",
        "Target 800-1600 words total",
        "Keep paragraphs to 4-8 sentences",
        "Dialogue should make up 12-32% of text"
      ]
    },
    "14-16": {
      "label": "High School (Ages 14-16)",
      "lexile_range": "1100-1200L",
      "corpus_metrics": {
        "texts_analyzed": 18,
        "sentence_length": {"mean": 20.5, "std": 4.2, "range": [17, 25]},
        "paragraph_sentences": {"mean": 6.0, "range": [4, 9]},
        "dialogue_ratio": {"mean": 0.22, "range": [0.10, 0.30]},
        "word_count": {"mean": 1500, "range": [1000, 2000]},
        "complexity": {"passive_voice": 0.15, "complex_sentences": 0.42}
      },
      "narrative": {
        "max_characters": 4,
        "conflict_count": 3,
        "timeline": "flexible",
        "emotion_expression": "implicit",
        "inference_level": "high",
        "moral_clarity": "implicit",
        "flashbacks": true,
        "unreliable_narrator": "allowed"
      },
      "cognitive": {
        "cause_effect": "can_be_inferred",
        "internal_thoughts": true,
        "subplots": "multiple_allowed",
        "dialogue_purpose": "multifunctional",
        "thematic_complexity": "layered"
      },
      "guidance": [
        "Up to four main characters allowed",
        "Complex character psychology and motivation",
        "Abstract themes and symbolism permitted",
        "Multiple subplots that interweave",
        "Ambiguous endings acceptable",
        "Sophisticated narrative techniques allowed",
        "Target 1000-2000 words total",
        "Paragraphs may be longer for effect",
        "Dialogue ratio flexible based on genre"
      ]
    },
    "16-18": {
      "label": "Advanced High School (Ages 16-18)",
      "lexile_range": "1200-1400L",
      "corpus_metrics": {
        "texts_analyzed": 15,
        "sentence_length": {"mean": 23.0, "std": 5.0, "range": [18, 30]},
        "paragraph_sentences": {"mean": 6.5, "range": [4, 10]},
        "dialogue_ratio": {"mean": 0.20, "range": [0.08, 0.28]},
        "word_count": {"mean": 1800, "range": [1200, 2500]},
        "complexity": {"passive_voice": 0.18, "complex_sentences": 0.50}
      },
      "narrative": {
        "max_characters": 5,
        "conflict_count": 4,
        "timeline": "flexible",
        "emotion_expression": "implicit",
        "inference_level": "high",
        "moral_clarity": "implicit",
        "flashbacks": true,
        "unreliable_narrator": "allowed",
        "metafiction": "allowed"
      },
      "cognitive": {
        "cause_effect": "can_be_inferred",
        "internal_thoughts": true,
        "subplots": "complex_weaving",
        "dialogue_purpose": "multifunctional",
        "thematic_complexity": "sophisticated",
        "philosophical_content": "allowed"
      },
      "guidance": [
        "Up to five main characters with distinct arcs",
        "Full range of literary techniques available",
        "Abstract and philosophical themes permitted",
        "Complex moral ambiguity acceptable",
        "Experimental narrative structures allowed",
        "College-prep reading level expected",
        "Target 1200-2500 words total",
        "Paragraph and sentence variety for stylistic effect",
        "All dialogue levels appropriate based on content"
      ]
    }
  }
}
