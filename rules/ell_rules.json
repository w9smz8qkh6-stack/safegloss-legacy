{
  "$schema": "ell_rules_schema.json",
  "description": "English Language Learner overlay rules",
  "version": "1.0.0",
  "note": "These rules overlay age/genre/lexile rules when ELL mode is enabled",
  "levels": {
    "beginner": {
      "label": "ELL Beginner (CEFR A1-A2)",
      "vocabulary": {
        "prefer_cognates": true,
        "avoid_idioms": true,
        "avoid_phrasal_verbs": true,
        "define_new_words": "inline",
        "frequency_tier": "top_1000"
      },
      "grammar": {
        "prefer_svo_order": true,
        "avoid_contractions": false,
        "avoid_passive": true,
        "avoid_conditionals": true,
        "tense_complexity": "simple"
      },
      "cultural": {
        "avoid_culture_specific_references": true,
        "explain_customs": true,
        "use_universal_themes": true
      },
      "guidance": [
        "Use high-frequency vocabulary from top 1000 words",
        "Avoid idioms and figurative language",
        "Avoid phrasal verbs (use single-word alternatives)",
        "Define difficult words immediately in context",
        "Use clear subject-verb-object sentence order",
        "Stick to simple present and past tenses",
        "Avoid culture-specific references that need background knowledge"
      ]
    },
    "intermediate": {
      "label": "ELL Intermediate (CEFR B1)",
      "vocabulary": {
        "prefer_cognates": true,
        "avoid_idioms": "complex_only",
        "avoid_phrasal_verbs": "complex_only",
        "define_new_words": "stretch_words_only",
        "frequency_tier": "top_3000"
      },
      "grammar": {
        "prefer_svo_order": true,
        "avoid_contractions": false,
        "avoid_passive": "mostly",
        "avoid_conditionals": "complex_only",
        "tense_complexity": "moderate"
      },
      "cultural": {
        "avoid_culture_specific_references": "obscure_only",
        "explain_customs": "when_central",
        "use_universal_themes": true
      },
      "guidance": [
        "Use vocabulary from top 3000 words",
        "Simple idioms allowed if meaning is clear",
        "Common phrasal verbs acceptable",
        "Define stretch words in context",
        "Past progressive and simple future allowed",
        "Explain cultural references when central to plot"
      ]
    },
    "advanced": {
      "label": "ELL Advanced (CEFR B2)",
      "vocabulary": {
        "prefer_cognates": "when_natural",
        "avoid_idioms": false,
        "avoid_phrasal_verbs": false,
        "define_new_words": "rare_only",
        "frequency_tier": "top_5000"
      },
      "grammar": {
        "prefer_svo_order": "natural",
        "avoid_contractions": false,
        "avoid_passive": false,
        "avoid_conditionals": false,
        "tense_complexity": "full"
      },
      "cultural": {
        "avoid_culture_specific_references": false,
        "explain_customs": "when_essential",
        "use_universal_themes": "preferred"
      },
      "guidance": [
        "Vocabulary from top 5000 words",
        "Common idioms allowed",
        "Phrasal verbs allowed",
        "Only define rare or specialized words",
        "Full range of tenses allowed",
        "Cultural references acceptable with context"
      ]
    }
  },
  "general_ell_guidance": [
    "Prefer concrete over abstract nouns",
    "Use repetition to reinforce key vocabulary",
    "Provide context clues for new words",
    "Use consistent terminology (don't vary terms unnecessarily)",
    "Include visual or sensory descriptions to support comprehension"
  ]
}
